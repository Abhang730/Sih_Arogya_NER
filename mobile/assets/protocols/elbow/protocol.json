{
  "$schema": "../schema/joint_protocol.schema.json",
  "joint_id": "elbow",
  "protocol_version": "1.0.0",
  "display": {
    "title": "Elbow Assessment",
    "short_title": "Elbow",
    "body_map_region": "elbow",
    "laterality_required": true
  },
  "status": "future",
  "supported_sides": ["left", "right", "both"],

  "clinical_questionnaire": {
    "instrument": "QuickDASH",
    "instrument_version": "to be confirmed with clinical advisor",
    "status": "pending_clinical_sign_off",
    "reference_instrument": "QuickDASH is the candidate named here. A region-specific elbow instrument may be preferred at clinical review.",
    "$status_reason": "PRD §12.2 lists elbow as a future module with no named instrument. No item set is transcribed until clinical sign-off.",
    "licence_note": "DASH/QuickDASH carry their own licensing terms."
  },

  "camera_setup": {
    "views": ["side_right", "side_left", "front"],
    "full_body_required": false,
    "est_distance_m": { "min": 1.2, "max": 2.5 },
    "framing_note_key": "cam.elbow.framing",
    "min_visibility_landmarks": [
      "left_shoulder", "right_shoulder", "left_elbow", "right_elbow",
      "left_wrist", "right_wrist"
    ]
  },

  "movement_tests": [
    {
      "id": "elbow_flexion_extension",
      "name_key": "test.elbow.flexion_extension.name",
      "instruction_key": "test.elbow.flexion_extension.instruction",
      "kind": "active_rom",
      "repeat_count": 3,
      "required": true,
      "camera_view": "side_right",
      "derived_features": ["elbow_flexion_rom", "elbow_extension_deficit"]
    },
    {
      "id": "elbow_pronation_supination",
      "name_key": "test.elbow.rotation.name",
      "instruction_key": "test.elbow.rotation.instruction",
      "kind": "active_rom",
      "repeat_count": 3,
      "required": false,
      "camera_view": "front",
      "derived_features": ["elbow_rotation_proxy"]
    }
  ],

  "landmark_subset": {
    "joint_chains": [
      { "name": "right_elbow_flexion", "landmarks": ["right_shoulder", "right_elbow", "right_wrist"], "angle_feature": "elbow_flexion_angle_right" },
      { "name": "left_elbow_flexion", "landmarks": ["left_shoulder", "left_elbow", "left_wrist"], "angle_feature": "elbow_flexion_angle_left" }
    ],
    "primary_angle": "elbow_flexion_angle_right"
  },

  "wearable": {
    "supported": true,
    "configurations": [
      {
        "id": "single_pod_forearm",
        "pods": [{ "pod_index": 1, "segment": "forearm", "placement_key": "place.elbow.pod1.forearm" }],
        "label_key": "wearable.elbow.single",
        "status": "preferred",
        "$note": "PRD §12.2 representative placement: forearm/upper-arm configuration."
      },
      {
        "id": "dual_pod_upper_arm_forearm",
        "pods": [
          { "pod_index": 1, "segment": "upper_arm", "placement_key": "place.elbow.pod1.upper_arm" },
          { "pod_index": 2, "segment": "forearm", "placement_key": "place.elbow.pod2.forearm" }
        ],
        "label_key": "wearable.elbow.dual",
        "status": "untrained",
        "$note": "Would estimate relative elbow motion."
      }
    ],
    "sensor_channels": ["acc_x", "acc_y", "acc_z", "gyro_x", "gyro_y", "gyro_z"],
    "sample_rate_hz": 50
  },

  "feature_pipeline": [
    { "key": "elbow_flexion_angle_right", "group": "camera_kinematics", "unit": "deg", "source": "camera", "description": "Right elbow flexion angle from the shoulder-elbow-wrist chain. The protocol's primary angle item." },
    { "key": "elbow_flexion_angle_left", "group": "camera_kinematics", "unit": "deg", "source": "camera", "description": "Left elbow flexion angle from the shoulder-elbow-wrist chain." },
    { "key": "elbow_flexion_rom", "group": "camera_kinematics", "unit": "deg", "source": "derived", "description": "Active elbow flexion range of motion." },
    { "key": "elbow_extension_deficit", "group": "camera_kinematics", "unit": "deg", "source": "derived", "description": "Shortfall from full extension." },
    { "key": "elbow_rotation_proxy", "group": "camera_kinematics", "unit": "ratio", "source": "derived", "description": "Pronation/supination proxy from wrist landmark rotation.", "research_grade": true },
    { "key": "imu_acc_magnitude_mean", "group": "imu_acc", "unit": "g", "source": "wearable", "description": "Mean Euclidean acceleration magnitude." },
    { "key": "imu_gyro_magnitude_mean", "group": "imu_gyro", "unit": "deg/s", "source": "wearable", "description": "Mean angular velocity magnitude." },
    { "key": "imu_signal_quality", "group": "imu_acc", "unit": "ratio", "source": "derived", "description": "Sensor quality score." }
  ],

  "models": [
    {
      "branch": "camera_temporal",
      "model_id": "elbow_camera_tcn",
      "version": "0.0.0",
      "target": { "label": "elbow_oa_risk_marker", "label_source": "none available", "label_provenance": "no public labelled pose-sequence dataset for elbow OA is wired in" },
      "deployment": ["edge_tflite"],
      "architecture": "1D-CNN / TCN over engineered pose features",
      "training_status": "untrained_insufficient_data",
      "explainability": "feature_attribution",
      "input_modalities": ["pose_landmarks"],
      "limitations": ["Deliberately untrained."]
    },
    {
      "branch": "imu_temporal",
      "model_id": "elbow_imu_temporal",
      "version": "0.0.0",
      "target": { "label": "elbow_oa_risk_marker", "label_source": "none available", "label_provenance": "no elbow cohort exists in the sourced datasets" },
      "deployment": ["edge_tflite"],
      "architecture": "TCN over IMU features",
      "training_status": "untrained_insufficient_data",
      "explainability": "feature_attribution",
      "input_modalities": ["imu_thigh"],
      "limitations": ["Untrained — genuine dataset coverage gap."]
    },
    {
      "branch": "clinical_tabular",
      "model_id": "elbow_clinical_xgb",
      "version": "0.0.0",
      "target": { "label": "elbow_oa_risk_marker", "label_source": "none available", "label_provenance": "questionnaire not yet configured" },
      "deployment": ["edge_tflite"],
      "architecture": "XGBoost + SHAP",
      "training_status": "untrained_insufficient_data",
      "explainability": "shap",
      "input_modalities": ["questionnaire"],
      "limitations": ["Blocked on questionnaire clinical sign-off."]
    },
    {
      "branch": "fusion",
      "model_id": "elbow_fusion_lr",
      "version": "0.0.0",
      "target": { "label": "elbow_oa_risk_marker", "label_source": "none available", "label_provenance": "no trained contributing branch" },
      "deployment": ["edge_tflite"],
      "architecture": "calibrated logistic regression",
      "training_status": "untrained_insufficient_data",
      "explainability": "feature_attribution",
      "input_modalities": ["pose_landmarks"],
      "limitations": ["All branches untrained, so no fused score is emitted."]
    }
  ],

  "risk_logic": {
    "bands": [
      { "id": "low", "min_score": 0.0, "label_key": "risk.low", "action_key": "action.self_care" },
      { "id": "moderate", "min_score": 0.40, "label_key": "risk.moderate", "action_key": "action.phc_review" },
      { "id": "high", "min_score": 0.70, "label_key": "risk.high", "action_key": "action.specialist_review" }
    ],
    "default_referral": "phc_review",
    "threshold_provenance": "PLACEHOLDER — UI bucket boundaries only; no model consumes them.",
    "operating_point": { "priority": "sensitivity", "rationale": "PRD §33: under-referral is rated High impact." },
    "deferral": { "allowed": true, "reason_required": true }
  },

  "report_template": [
    { "section_id": "patient", "title_key": "report.section.patient", "fields": ["arogya_patient_id", "masked_identity", "age", "sex", "datetime"] },
    { "section_id": "worker_site", "title_key": "report.section.worker_site", "fields": ["worker_id", "worker_name", "phc", "district"] },
    { "section_id": "initial_screen", "title_key": "report.section.initial_screen", "fields": ["pain_map", "mobility_summary", "exposure_profile"] },
    { "section_id": "targeted_joint", "title_key": "report.section.targeted_joint", "fields": ["joint", "side", "elbow_flexion_rom", "sensor_findings"] },
    { "section_id": "ai_result", "title_key": "report.section.ai_result", "fields": ["measurement_summary", "protocol_status_notice"] },
    { "section_id": "referral", "title_key": "report.section.referral", "fields": ["recommended_action", "urgency"] },
    { "section_id": "preventive_guidance", "title_key": "report.section.preventive_guidance", "fields": ["guidance_items"] },
    { "section_id": "disclaimer", "title_key": "report.section.disclaimer", "fields": ["screening_not_diagnosis"] }
  ],

  "safety": {
    "contraindications": [
      "Recent elbow fracture or dislocation within the clinician-set recovery window",
      "Uncontrolled pain preventing active movement",
      "Suspected acute infection"
    ],
    "red_flags": ["Hot swollen joint with fever", "Trauma with deformity", "Progressive neurological symptoms in the hand"],
    "stop_conditions": ["Pain above the patient's stated tolerable level", "Patient requests to stop"],
    "disclaimer_key": "disclaimer.screening_not_diagnosis"
  }
}
